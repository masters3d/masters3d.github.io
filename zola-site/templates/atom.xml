{% if config.generate_feeds %}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
    <id>{{ get_url(path="atom.xml") }}</id>
    <title>{{ config.title }}</title>
    {% if config.description %}
    <subtitle>{{ config.description }}</subtitle>
    {% endif %}
    <updated>{{ now() | date(format="%+") }}</updated>
    <link rel="alternate" type="text/html" href="{{ config.base_url }}"/>
    <link rel="self" type="application/atom+xml" href="{{ get_url(path="atom.xml") }}"/>
    <generator uri="https://www.getzola.org/">Zola</generator>
    {% if config.extra.github_username %}
    <author>
        <name>{{ config.extra.github_username }}</name>
        <uri>{{ config.base_url }}</uri>
    </author>
    {% endif %}
</feed>
{% endif %}